# Copie ce fichier en ".env" (en local) OU mets ces variables dans le panneau
# "Environment" de ton hébergeur gratuit. Ne publie JAMAIS le vrai .env sur GitHub.

# --- Discord (https://discord.com/developers/applications) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# Lien d'invitation permanent affiché sur le site
DISCORD_INVITE=https://discord.gg/NjzVdDvWS2
# Optionnel : salon d'annonces. Les messages postés dedans sont copiés sur le site.
# (il faut activer "Message Content Intent" dans le portail développeur Discord)
ANNOUNCE_CHANNEL_ID=

# --- GitHub : dépôt du site ---
# Jeton "fine-grained" limité à CE dépôt, permission "Contents: Read and write"
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Site ---
# Adresse du site GitHub Pages (pour /site et la sécurité CORS)
SITE_URL=https://ton-pseudo.github.io/nexoria/

# --- Serveur web du bot (l'hébergeur fournit souvent PORT tout seul) ---
PORT=3000
